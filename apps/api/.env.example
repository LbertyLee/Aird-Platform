NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent?schema=public&connection_limit=5&pool_timeout=20
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=agent
MINIO_SECRET_KEY=agent-local-secret
MINIO_BUCKET=ai-research
MINIO_FALLBACK_BUCKETS=agent-files
JWT_SECRET=replace-with-at-least-32-characters
STORAGE_DRIVER=postgres
STORAGE_FALLBACK_TO_MEMORY=false
EXA_API_KEY=
INTERNATIONAL_API_TIMEOUT_MS=12000
UN_COMTRADE_API_KEY=
# Optional: metric keyword -> official OECD SDMX CSV data URL template; supports {start}/{end}.
OECD_SDMX_QUERY_TEMPLATES_JSON=
EXA_SEARCH_COUNT=20
EXTERNAL_ANSWER_TOP_K=10
EXTERNAL_RERANK_CANDIDATE_MAX=250
EXTERNAL_PLATFORM_SCORE_WEIGHT=0.5
EXTERNAL_EXA_SCORE_WEIGHT=0.5
EXTERNAL_SOURCE_TRUST_JSON={"stats.gov.cn":1,"worldbank.org":0.98}
EXA_SOURCE_DOMAIN_BATCH_SIZE=20
EXA_SOURCE_SEARCH_CONCURRENCY=4
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_CACHE_VERSION=v1
STRUCTURED_DATA_CACHE_ENABLED=true
STRUCTURED_DATA_CACHE_DIR=storage/structured-data
SEARCH_CACHE_TTL_SECONDS=30
AI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-plus-2026-05-26
# 证据评估、研究结论、跨来源分析和综合报告；共用 AI_API_KEY / OPENAI_BASE_URL
OPENAI_REASONING_MODEL=qwen3.8-max
OPENAI_TIMEOUT_MS=60000
RESEARCH_PLANNING_TIMEOUT_MS=120000
RERANKER_BASE_URL=
RERANKER_MODEL=rerank
RERANKER_TIMEOUT_MS=2500
# 无文本层 PDF（Microsoft 打印为 PDF / 扫描件）视觉识别
PDF_OCR_MODEL=qwen-vl-ocr
JWT_ACCESS_TTL_SEC=7200
JWT_REFRESH_TTL_SEC=604800
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MILVUS_ADDRESS=localhost:19530
# Startup does not create, drop, or recreate shared Milvus collections.
# Set true only for an isolated Milvus instance that is safe to modify.
MILVUS_SCHEMA_CHANGES_ON_START=false
# openai（硅基流动等）或 dashscope-multimodal（Qwen3-VL-Embedding）
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_MS=30000
# DashScope text-embedding-v4 等单次 input 最多 10 条
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CONCURRENCY=2
MILVUS_SEARCH_TIMEOUT_MS=15000
# 百炼多模态示例：
# EMBEDDING_PROVIDER=dashscope-multimodal
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# EMBEDDING_MODEL=qwen3-vl-embedding
# EMBEDDING_DIM=1024
# 系统自动备份（PostgreSQL + MinIO 业务文件 + 环境配置）
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_PREFIX=system-backups/
# 可选：额外写入本机目录（生产建议挂载到 MinIO 数据盘以外的路径）
BACKUP_LOCAL_DIR=
# 腾讯云短信（控制台 SMS 应用 SDKAppID + 已审核签名/模板；SecretId/SecretKey 在 CAM 创建）
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_CODE_TTL_SEC=300
TENCENT_SMS_SEND_INTERVAL_SEC=60
# 本地未配 Secret 时可填固定码；生产请留空并配齐上方项
TENCENT_SMS_PREVIEW_CODE=
# 支付宝电脑网站支付（沙箱 gateway 见 ALIPAY_GATEWAY）
ALIPAY_ENABLED=false
ALIPAY_SELLER_ID=
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
# 应用私钥：单行 Base64 或 PEM；也可将密钥文件放在 config/alipay/
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_PATH=
# 开放平台「支付宝公钥」（非应用公钥），验签异步通知必填
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_PATH=
# 未显式配置时由下列公网地址拼接 notify / return
API_PUBLIC_BASE_URL=
WEB_PUBLIC_BASE_URL=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_WEB_RETURN_URL=
ALIPAY_KEY_TYPE=PKCS8
# 沙箱 WebSocket 主机（Node 端需 Java MsgClient 转发，见 payment 模块说明）
ALIPAY_WS_HOST=openchannel.sx.alipaydev.com
PAYMENT_MOCK_ENABLED=false
# 微信支付 API v3 直连商户 Native（文件路径相对于 API 进程工作目录）
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PRIVATE_KEY_PATH=config/wechat/apiclient_key.pem
WECHAT_PAY_CERT_PATH=config/wechat/apiclient_cert.pem
# 微信支付平台公钥，不能使用商户证书或商户公钥代替
WECHAT_PAY_PUBLIC_KEY_PATH=config/wechat/wechatpay_public_key.pem
# 文件仅含 32 字节 APIv3 密钥，不在环境文件直接存放密钥
WECHAT_PAY_API_V3_KEY_PATH=config/wechat/apiv3_key.txt
WECHAT_PAY_NOTIFY_URL=
