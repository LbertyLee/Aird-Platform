IMAGE_TAG=latest

# 对外端口。生产环境建议仅将管理端、用户端和 MinIO API 暴露给反向代理。
API_HOST_PORT=13000
ADMIN_HOST_PORT=13001
WEB_HOST_PORT=13002
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# 将 example.com 替换为服务器公网 IP 或域名；HTTPS 反向代理请填实际 HTTPS origin。
MINIO_PUBLIC_ENDPOINT=http://example.com:9000
CORS_ORIGINS=http://example.com:13001,http://example.com:13002

# PostgreSQL / Redis / MinIO 凭据。部署前必须替换为强随机值。
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password
MINIO_ROOT_USER=agent
MINIO_ROOT_PASSWORD=change-this-minio-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters


# 应用功能配置：按实际接入的服务填写。
MINIO_BUCKET=ai-research
MINIO_FALLBACK_BUCKETS=agent-files
STORAGE_DRIVER=postgres
STORAGE_FALLBACK_TO_MEMORY=false
# Collection schema changes are destructive; enable only for an isolated Milvus instance.
MILVUS_SCHEMA_CHANGES_ON_START=false
AI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-plus-2026-05-26
# 复杂推理模型，共用 AI_API_KEY / OPENAI_BASE_URL
OPENAI_REASONING_MODEL=qwen3.8-max
PDF_OCR_MODEL=qwen-vl-ocr
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CONCURRENCY=2
EXA_API_KEY=
EXA_SEARCH_COUNT=40
EXA_SOURCE_DOMAIN_BATCH_SIZE=50
EXA_SOURCE_SEARCH_CONCURRENCY=4
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_CACHE_VERSION=v1
STRUCTURED_DATA_CACHE_ENABLED=true
STRUCTURED_DATA_CACHE_DIR=/app/apps/api/storage/structured-data
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_PREFIX=system-backups/
BACKUP_LOCAL_DIR=/backups

# 腾讯云短信（线上写入 deploy/.env；CAM 密钥勿提交 Git）
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_CODE_TTL_SEC=300
TENCENT_SMS_SEND_INTERVAL_SEC=60
TENCENT_SMS_PREVIEW_CODE=

# 微信 Native 支付：证书/密钥单独放到服务器 apps/api/config/wechat/，不要提交 Git。
# 两套 Compose 均只读挂载该目录；完整材料就绪后再启用。
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PRIVATE_KEY_PATH=config/wechat/apiclient_key.pem
WECHAT_PAY_CERT_PATH=config/wechat/apiclient_cert.pem
WECHAT_PAY_PUBLIC_KEY_PATH=config/wechat/wechatpay_public_key.pem
WECHAT_PAY_API_V3_KEY_PATH=config/wechat/apiv3_key.txt
WECHAT_PAY_NOTIFY_URL=

